# Supabase Postgres connection values. Keep this file as placeholders only.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase Auth issuer. The API validates access tokens issued by this project.
SUPABASE_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1

# The only browser origin allowed to call the API in local development.
FRONTEND_ORIGIN=http://localhost:5173

# Keep true for normal use. Set false only when intentionally sharing one public archive.
AUTH_ENABLED=true
# Used only while AUTH_ENABLED=false.
PUBLIC_OWNER_ID=00000000-0000-0000-0000-000000000001
