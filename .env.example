# Supabase browser configuration. The publishable key is safe to expose; never
# put SUPABASE_SERVICE_ROLE_KEY in this file or in a VITE_ variable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Java API base URL; defaults to http://localhost:8080 during local development.
VITE_HEALTH_API_URL=http://localhost:8080
